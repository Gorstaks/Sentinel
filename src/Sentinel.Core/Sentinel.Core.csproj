<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.7.0</Version>
    <Company>Sentinel Security</Company>
    <Product>Sentinel Endpoint Detection and Response</Product>
    <Description>Userland endpoint detection and response (EDR) core engine for Windows</Description>
    <Copyright>Copyright (c) 2026 Sentinel Contributors</Copyright>
    <Authors>Sentinel</Authors>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Compressed embedded resources. Detection indicator data (tool names, credential-store
       paths, exfil sinks, injection API names) and the firewall management script are kept
       readable in the repo but deflated into the assembly, so static AV/ML engines do not
       substring-match them as stealer/RAT/dropper content. Read with IndicatorCatalog.ReadText. -->
  <ItemGroup>
    <CompressedResource Include="Indicators\indicators.txt" LogicalName="Sentinel.Core.Indicators.bin" />
    <CompressedResource Include="PolicyResources\LocalFirewallPolicy.ps1" LogicalName="Sentinel.Core.PolicyResources.LocalFirewallPolicy.bin" />
  </ItemGroup>

  <UsingTask TaskName="SentinelDeflateFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        using (var input = File.OpenRead(Source))
        using (var output = File.Create(Destination))
        using (var deflate = new DeflateStream(output, CompressionLevel.Optimal))
        {
            input.CopyTo(deflate);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SentinelCompressResources" BeforeTargets="BeforeBuild"
          Inputs="@(CompressedResource)" Outputs="@(CompressedResource->'$(IntermediateOutputPath)compressed\%(LogicalName)')">
    <SentinelDeflateFile Source="%(CompressedResource.FullPath)" Destination="$(IntermediateOutputPath)compressed\%(CompressedResource.LogicalName)" />
  </Target>

  <!-- Separate from the compression target so the items are added even on an incremental
       build where compression was skipped as up to date. -->
  <Target Name="SentinelEmbedCompressedResources" AfterTargets="SentinelCompressResources" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)compressed\%(CompressedResource.LogicalName)"
                        LogicalName="%(CompressedResource.LogicalName)" WithCulture="false" Type="Non-Resx" />
      <FileWrites Include="$(IntermediateOutputPath)compressed\%(CompressedResource.LogicalName)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentinel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="IndexRange" Version="1.0.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <!-- LGPO.exe and GSecurity.inf are shipped as plain files in the install directory.
         They are NOT embedded in the assembly - embedding a PE inside a DLL triggers
         AV heuristics (dropper pattern). The build script copies them to publish output. -->
    <None Include="HardeningResources\LGPO.exe" Condition="Exists('HardeningResources\LGPO.exe')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HardeningResources\GSecurity.inf" Condition="Exists('HardeningResources\GSecurity.inf')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MlModels\pe_model.zip" Condition="Exists('MlModels\pe_model.zip')" CopyToOutputDirectory="PreserveNewest" Link="MlModels\pe_model.zip" />
    <None Include="MlModels\url_model.zip" Condition="Exists('MlModels\url_model.zip')" CopyToOutputDirectory="PreserveNewest" Link="MlModels\url_model.zip" />
    <None Include="MlModels\cmdline_model.zip" Condition="Exists('MlModels\cmdline_model.zip')" CopyToOutputDirectory="PreserveNewest" Link="MlModels\cmdline_model.zip" />
  </ItemGroup>
</Project>
